// Shared emoticon rendering helpers. Included by both the HUD (EmoticonsHud.uci)
// and the scoreboards so player names on the scoreboard render emoticons too.
// These are self-contained: they take the replication info + canvas and do not
// touch any HUD-only state (that is why the icon is drawn with an explicit white
// C.MakeColor instead of the HUD's default.WhiteColor).
// Finding the emoticons in a string is done once per string and cached by
// EmoticonsReplicationInfo.GetParsedText; these only draw the cached result.

// Borrowed from AssaultPlus by Marco a.k.a .:..: and modified to work with configurable and replicatable emoticons.
// IconScale scales the emoticon icons relative to the line height (1.0 = full
// line height, as used in chat). Pass e.g. 0.5 for smaller icons on the
// scoreboard. Values <= 0 are treated as 1.0.
function DrawSmileyText( EmoticonsReplicationInfo replication, string S, canvas C, optional out float XXL, optional out float XYL, optional float IconScale )
{
    // Fallback to the default behavior if we have not received the replicated state yet.
    if (replication == none) {
        C.DrawTextClipped(s, true);
        return;
    }

	DrawParsedSmileyText(replication.GetParsedText(S), C, XXL, XYL, IconScale);
}

// Draws a string already split by EmoticonsReplicationInfo.GetParsedText.
// Same parameters as DrawSmileyText.
function DrawParsedSmileyText( EmoticonsParsedText P, canvas C, optional out float XXL, optional out float XYL, optional float IconScale )
{
	local int i,n;
	local float PX,PY,XL,YL,CurX,CurY,SScale,Sca,AdditionalY,NewAY;
	local color OrgC;
	local Texture EIcon;
	local Material MIcon;

	if (IconScale <= 0)
		IconScale = 1.0;

	// Initilize
	C.StrLen("T",XL,YL);
	SScale = YL * IconScale;
	PX = C.CurX;
	PY = C.CurY;
	CurX = PX;
	CurY = PY;
	OrgC = C.DrawColor;
	n = P.IconTex.Length;
	for( i = 0; i < n; i++ )
	{
		// Draw text behind
		C.SetPos(CurX,CurY);
		C.DrawText(P.Texts[i]);
		// Draw smile
		C.StrLen(P.VisTexts[i],XL,YL);
		CurX+=XL;
		While( CurX>C.ClipX )
		{
			CurY+=(YL+AdditionalY);
			AdditionalY = 0;
			CurX-=C.ClipX;
		}
		C.DrawColor = C.MakeColor(255,255,255,255);
		C.SetPos(CurX,CurY);
		if( P.IconTex[i] != None )
		{
			EIcon = P.IconTex[i];
			if( EIcon.USize == 16 )
				Sca = SScale;
			else Sca = EIcon.USize/32*SScale;
			C.DrawTile( EIcon, Sca, Sca, 0, 0, EIcon.USize, EIcon.VSize );
		}
		else if( P.IconMat[i] != None )
		{
			MIcon = P.IconMat[i];
			if( MIcon.MaterialUSize() == 16 )
				Sca = SScale;
			else Sca = MIcon.MaterialUSize()/32*SScale;
			C.DrawTile( MIcon, Sca, Sca, 0, 0, MIcon.MaterialUSize(), MIcon.MaterialVSize() );
		}

		if( Sca>SScale )
		{
			NewAY = (Sca-SScale);
			if( NewAY>AdditionalY )
				AdditionalY = NewAY;
			NewAY = 0;
		}
		CurX+=Sca;
		While( CurX>C.ClipX )
		{
			CurY+=(YL+AdditionalY);
			AdditionalY = 0;
			CurX-=C.ClipX;
		}
		// Then go for next smile
		C.DrawColor = OrgC;
	}
	// Then draw rest of text remaining
	C.SetPos(CurX,CurY);
	C.StrLen(P.VisTexts[n],XL,YL);
	C.DrawText(P.Texts[n]);
	CurX+=XL;
	While( CurX>C.ClipX )
	{
		CurY+=(YL+AdditionalY);
		AdditionalY = 0;
		CurX-=C.ClipX;
	}
	XYL+=AdditionalY;
	AdditionalY = 0;
	XXL = CurX;
	C.SetPos(PX,PY);
}
