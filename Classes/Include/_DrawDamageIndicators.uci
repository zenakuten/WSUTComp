
simulated function DrawDamageIndicators(Canvas C)
{
    local BS_xPlayer PC;

    Super.DrawDamageIndicators(C);

    if(bHideHud)
        return;

    PC = BS_xPlayer(PlayerOwner);
    if(PC == None || PC.HUDSettings.DamageIndicatorType != 2 || PC.SumDamageTime + 1 <= Level.TimeSeconds)
        return;

    // GetFontSizeIndex only depends on ClipX; the text size also depends on the value.
    if(C.ClipX != DmgNumClipX || DmgNumFont == None)
    {
        DmgNumClipX = C.ClipX;
        if(C.ClipX >= 1600)
            DmgNumFont = GetFontSizeIndex(C, -2);
        else
            DmgNumFont = GetFontSizeIndex(C, -1);
        DmgNumText = "";
    }
    C.Font = DmgNumFont;

    if(DmgNumText == "" || PC.SumDamage != DmgNumValue)
    {
        DmgNumValue = PC.SumDamage;
        DmgNumText = string(DmgNumValue);
        C.StrLen(DmgNumText, DmgNumXL, DmgNumYL);
    }

    C.DrawColor = class'Emitter_Damage'.static.ColorRamp(DmgNumValue);
    C.DrawColor.A = Clamp(int(((PC.SumDamageTime + 1) - Level.TimeSeconds) * 200), 1, 200);

    C.SetPos((C.ClipX - DmgNumXL) * 0.5, (C.ClipY - DmgNumYL) * 0.46);
    C.DrawTextClipped(DmgNumText);
}
